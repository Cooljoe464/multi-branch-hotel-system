{
    "openapi": "3.1.0",
    "info": {
        "title": "Hotel PMS Partner API",
        "version": "1"
    },
    "servers": [
        {
            "url": "/api"
        }
    ],
    "components": {
        "securitySchemes": {
            "bearerAuth": {
                "type": "http",
                "scheme": "bearer",
                "description": "Sanctum consumer token."
